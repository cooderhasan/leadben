# ── Veritabanı ─────────────────────────────────────────────
DATABASE_URL="postgresql://salesos:salesos@localhost:55432/salesos?schema=public"
# Entegrasyon testleri için ayrı veritabanı (npm test)
TEST_DATABASE_URL="postgresql://salesos:salesos@localhost:55432/salesos_test?schema=public"

# ── Uygulama ───────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Entegrasyon sırlarını şifrelemek için 32 byte base64 anahtar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Şirket gizli anahtarlarını (WhatsApp token, webhook sırları) şifreler. Production'da zorunlu; sonradan değiştirmeyin.
ENCRYPTION_KEY=""
# Yeni şirkete açılışta verilecek deneme kredisi
SIGNUP_CREDITS=500

# ── AI ─────────────────────────────────────────────────────
# anthropic | openai | gemini
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-5"
# Hızlı/ucuz işlemler (sınıflandırma, kısa özet) için
AI_FAST_MODEL="claude-haiku-4-5-20251001"
# Birincil sağlayıcı hata verirse (boş = fallback yok)
AI_FALLBACK_PROVIDER=""
AI_FALLBACK_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Embedding: none | openai | gemini | voyage
# none → bilgi bankası Postgres tam metin araması ile çalışır
EMBEDDING_PROVIDER="none"
EMBEDDING_MODEL=""
VOYAGE_API_KEY=""

# ── Kuyruk ─────────────────────────────────────────────────
# inline → işler web sürecinde çalışır (geliştirme). bullmq → Redis + ayrı worker (production)
QUEUE_DRIVER="inline"
REDIS_URL="redis://localhost:6379"

# ── Dosya depolama ─────────────────────────────────────────
# local → ./storage klasörü. s3 → S3 uyumlu (MinIO, R2, AWS)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="ai-sales-os"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# ── Veri kaynakları (Faz 2) ────────────────────────────────
# Otomatik lead arama (Google Haritalar). Boşsa arama kapalı; CSV içe aktarma ve elle ekleme çalışır.
APIFY_TOKEN=""
# APIFY_GOOGLE_MAPS_ACTOR="compass~crawler-google-places"
# Tek aramada en fazla lead (her lead 1 kredi)
LEAD_SEARCH_MAX=50

# ── E-posta (Faz 3) ────────────────────────────────────────
# smtp | resend | brevo — boşsa gönderim kapalı (kampanya, mesaj üretimi ve onay yine çalışır)
EMAIL_PROVIDER=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
BREVO_API_KEY=""
# Şirket başına günlük gönderim sınırı (alan adı itibarını korur)
EMAIL_DAILY_LIMIT=50
# Ret bağlantısı imza anahtarı (production'da zorunlu, rastgele uzun bir değer)
UNSUBSCRIBE_SECRET=""
# Sağlayıcı webhook'ları: https://alanadiniz/api/webhooks/email/<resend|brevo>?token=<bu değer>
EMAIL_WEBHOOK_SECRET=""
# Gelen yanıtlar: gönderici posta kutusu IMAP ile SALT OKUNUR okunur (okundu işareti konmaz, silinmez).
# Sadece gönderdiğimiz iletilere verilen yanıtlar sisteme alınır; diğer postalar yok sayılır. Boşsa kapalı.
IMAP_HOST=""
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=""
IMAP_PASS=""
IMAP_MAILBOX=INBOX

# ── Zamanlayıcı (Faz 4: hatırlatmalar) ────────────────────
# Production'da uygulama içi zamanlayıcı her 5 dk çalışır (hatırlatmalar, rakip taraması, gelen posta). Birden fazla kopya varsa birinde açık bırakın.
SCHEDULER_ENABLED=true
# Dış cron kullanacaksanız: POST https://alanadiniz/api/cron/tick  (x-cron-token: <bu değer>)
CRON_SECRET=""
